{
  "$schema": "./states-recipe.schema.json",
  "_doc": "NUDGE-KNOB (determinism.md): the design-relevant SOLO state matrix per component. Brand-overridable. build-review-surface reads this to expand each registry entry into specimens. Keys are registry componentType keys; each entry lists named specimens with the literal RenderEngine props to render. `force` pins an interactive paint (data-force) so a still capture shows hover/focus/active. Omit a key to fall back to the registry default (one specimen from schema defaults). This file is the ONLY judgment in SOLO generation \u2014 everything downstream is mechanical.",
  "defaults": {
    "forceStates": [
      "hover",
      "focus",
      "active"
    ],
    "captionFromSpecimenName": true,
    "fallbackSpecimen": "registry-default",
    "_fallback": "A registry key absent from `components` still renders ONE specimen from its schema defaults (light+dark) \u2014 coverage never has holes; this recipe only WIDENS the meaningful keys past the single default."
  },
  "axes": {
    "_doc": "DETERMINISTIC (not a knob): the fixed, intent-derived checklist axes the surface renders per unit and the chrome serializes into feedback.json. The states above are brand-curated; these axes are the same for every brand because they are the dimensions design intent lives on (RESEARCH \u00a75). build-review-surface fills {{AXIS_LEGEND}} and the AXES loop from this list; review-chrome.js reads it as MANIFEST.axes.",
    "items": [
      {
        "key": "voice",
        "name": "Voice",
        "hint": "display face \u00b7 uppercase \u00b7 tabular figures"
      },
      {
        "key": "elevation",
        "name": "Elevation",
        "hint": "raised vs recessed \u2014 no resting outlines"
      },
      {
        "key": "media-drama",
        "name": "Media drama",
        "hint": "scrim depth + text legibility, both modes"
      },
      {
        "key": "rhythm",
        "name": "Rhythm",
        "hint": "spacing \u00b7 breath \u00b7 vertical cadence"
      },
      {
        "key": "color-budget",
        "name": "Color budget",
        "hint": "within the brand accent budget"
      },
      {
        "key": "both-mode-parity",
        "name": "Both-mode parity",
        "hint": "holds up in light AND dark"
      },
      {
        "key": "geometry",
        "name": "Geometry",
        "hint": "roundness · corners · shape compliance"
      },
      {
        "key": "typography",
        "name": "Typography",
        "hint": "font face · weight · size · case"
      },
      {
        "key": "ramp-step",
        "name": "Ramp step",
        "hint": "no 50/100/150 ramp steps as fills"
      },
      {
        "key": "prominence",
        "name": "Prominence",
        "hint": "contrast · emphasis · visible in both modes"
      },
      {
        "key": "container-fit",
        "name": "Container fit",
        "hint": "specimen renders at its own ratio"
      },
      {
        "key": "broken",
        "name": "Broken",
        "hint": "validation / render failure"
      }
    ]
  },
